# Upstream pin for the skyjo image. Read by .github/workflows/images.yml and
# passed to images/skyjo/Dockerfile as the SKYNET_REF build arg.
# Plain KEY=value lines only (no quotes, no shell).
#
# UPSTREAM_REF may be a full commit SHA (preferred), a tag or a branch. CI
# resolves it to the commit SHA and tags the image with that SHA.
# To bump: change the SHA here, then update the tag in
# k8s/apps/skyjo/helmrelease.yaml.
UPSTREAM_REPO=DevArtech/skynet
UPSTREAM_REF=e62a825d5fc1cc3e1e2d67e402254aa698eefcea
