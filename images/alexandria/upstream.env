# Upstream pin for BOTH Alexandria images. Read by .github/workflows/images.yml.
# Plain KEY=value lines only (no quotes, no shell).
#
# The images are built straight from the upstream Dockerfiles, using the git
# repository at this ref as the build context:
#   alexandria-mcp          <- Dockerfile        (repo root)
#   alexandria-oauth-proxy  <- proxy/Dockerfile  (context subdir proxy/)
# plus, from upstream's RELEASE binary (images/alexandria-cli/Dockerfile):
#   alexandria-cli          <- release asset of UPSTREAM_CLI_VERSION, checked
#                              against UPSTREAM_CLI_SHA256 (= the asset digest on
#                              the GitHub release page). CI fails unless that tag
#                              is the same commit as UPSTREAM_REF.
#
# UPSTREAM_REF may be a full commit SHA (preferred: reproducible), a tag or a
# branch. CI resolves it to the commit SHA and tags the images with that SHA.
# To bump: change the SHA here (or run the workflow by hand with a ref), then
# update the image tags in k8s/apps/alexandria/helmrelease.yaml. Bump
# UPSTREAM_CLI_VERSION/_SHA256 to the release of the new ref at the same time.
UPSTREAM_REPO=DevArtech/alexandria
UPSTREAM_REF=d4834470902654e0fffaf4e4af3f5bcf2a62d780
UPSTREAM_CLI_VERSION=v0.1.2
UPSTREAM_CLI_SHA256=15daaa8ed11ac4583d72869baf3afd7e4fae7fac3080a4cc3ec40baab5dfbdbd
