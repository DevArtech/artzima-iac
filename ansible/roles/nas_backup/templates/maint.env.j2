# Managed by Ansible (role nas_backup): DO NOT EDIT on the NAS. Holds the MAINTENANCE key.
RESTIC_REPOSITORY={{ nas_backup_repo_uri }}
RESTIC_PASSWORD={{ nas_restic_password }}
AWS_ACCESS_KEY_ID={{ nas_b2_maint_key_id }}
AWS_SECRET_ACCESS_KEY={{ nas_b2_maint_application_key }}
AWS_DEFAULT_REGION={{ b2_region }}
RESTIC_CACHE_DIR=/cache
KEEP_DAILY={{ nas_backup_keep_daily | int }}
KEEP_WEEKLY={{ nas_backup_keep_weekly | int }}
KEEP_MONTHLY={{ nas_backup_keep_monthly | int }}
ALERT_URL={{ nas_backup_alert_url }}
