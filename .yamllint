---
extends: default
ignore: |
  .private/
  ansible/collections/
  tofu/.terraform/
  tofu/cloudflare/.terraform/
  tofu/backblaze/.terraform/
  tofu/bootstrap/.terraform/
  .ansible/
  .tools/
rules:
  line-length:
    max: 160
    level: warning
  document-start: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
